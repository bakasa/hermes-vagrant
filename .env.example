# Hermes Crew — Railway Deployment Environment Variables
# Copy values into Railway service variables (Dashboard → Variables tab).
# For local Docker Compose: cp .env.example .env and fill in values.
# NEVER commit .env to git.
#
# Deploy flow:
#   git clone https://github.com/bakasa/hermes-vagrant
#   cd hermes-vagrant
#   railway link          # link to your Railway project
#   # Set the variables below in Railway dashboard or via:
#   # railway variable set KEY=value
#   railway up --detach   # builds + deploys

# ── Required ────────────────────────────────────────────────────────────────

# OpenRouter API key — LLM inference for all agents
OPENROUTER_API_KEY=sk-or-...

# Slack bot token (xoxb-...) — Main agent gateway
SLACK_BOT_TOKEN=xoxb-...

# Slack app-level token (xapp-...) — Socket Mode connection
SLACK_APP_TOKEN=xapp-...

# Comma-separated Slack user IDs allowed to interact with the bot
SLACK_ALLOWED_USERS=U0B5K7SURMJ

# GitHub PAT — repo, workflow, read:org, gist, admin:public_key scopes
GITHUB_TOKEN=ghp_...

# ── Optional ────────────────────────────────────────────────────────────────

# Anthropic API key — Coder agent Claude Code fallback
# ANTHROPIC_API_KEY=sk-ant-...

# Claude Code OAuth token — preferred over ANTHROPIC_API_KEY for Coder agent
# CLAUDE_CODE_OAUTH_TOKEN=...

# Google credentials — Alim agent (Google Classroom integration)
# GOOGLE_CREDENTIALS_PATH=/data/.hermes/alim/google_credentials.json
# GOOGLE_TOKEN_PATH=/data/.hermes/alim/google_token.json
