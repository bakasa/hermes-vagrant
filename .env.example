{
  "meta": {
    "description": "Environment variables for the Hermes multi-agent crew. Copy to .env and fill in values. NEVER commit .env to git."
  },
  "variables": {
    "GITHUB_TOKEN": {
      "required": true,
      "description": "GitHub PAT with repo, workflow, read:org, gist, admin:public_key scopes",
      "example": "ghp_xx...xxxx"
    },
    "OPENROUTER_API_KEY": {
      "required": true,
      "description": "OpenRouter API key for LLM inference",
      "example": "sk-or-...xxxx"
    },
    "SLACK_BOT_TOKEN": {
      "required": true,
      "description": "Slack bot token (xoxb-...) for the Main agent",
      "example": "xoxb-x...xxxx"
    },
    "SLACK_APP_TOKEN": {
      "required": true,
      "description": "Slack app-level token (xapp-...) for Socket Mode",
      "example": "xapp-x-xxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx"
    },
    "ANTHROPIC_API_KEY": {
      "required": false,
      "description": "Anthropic API key (for Coder agent Claude Code fallback). Prefer OAuth token below.",
      "example": "sk-ant...xxxx"
    },
    "CLAUDE_CODE_OAUTH_TOKEN": {
      "required": false,
      "description": "Claude Code OAuth token — preferred over ANTHROPIC_API_KEY for Coder agent",
      "example": "xxxxxxxxxxxxxxxx"
    }
  }
}
