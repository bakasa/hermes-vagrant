# Base Dockerfile for Hermes Agents
# Agents can FROM this directly, or write their own.
# Provides: basic tooling, Hermes CLI, hermes user with sudo.

FROM debian:bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git ca-certificates unzip jq \
    python3 python3-pip python3-venv \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create hermes user with passwordless sudo
RUN useradd -m -s /bin/bash hermes && \
    echo "hermes ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/hermes && \
    chmod 0440 /etc/sudoers.d/hermes

# Install Hermes Agent CLI
RUN curl -fsSL https://hermes-agent.nousresearch.com/install.sh | sh

# Shared directories
RUN mkdir -p /data/handoffs && chown hermes:hermes /data/handoffs
RUN mkdir -p /data/.hermes && chown hermes:hermes /data/.hermes

USER hermes
WORKDIR /data

EXPOSE 3000

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${GATEWAY_PORT:-3000}/health || exit 0
