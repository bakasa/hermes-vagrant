# Hermes Crew — single Railway-deployable image
# All 6 agents run as supervisord processes sharing /data for handoffs.
# To add a new agent: run add-agent.sh, add [program:hermes-<name>] to
# supervisord.railway.conf, then commit — Railway auto-deploys.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HERMES_HOME=/data/.hermes \
    TZ=UTC

# Runtime tools + nodejs/npm for coder agent + sudo for hermes user
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git ca-certificates jq \
    build-essential libssl-dev \
    sudo \
    supervisor \
    nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# hermes user with passwordless sudo (required for agent operations)
RUN useradd -m -u 10000 -s /bin/bash hermes && \
    echo "hermes ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/hermes && \
    chmod 0440 /etc/sudoers.d/hermes

# Install hermes-agent from PyPI (replaces broken nousresearch install.sh)
RUN pip install --no-cache-dir hermes-agent

# Claude Code CLI — coder agent delegates tasks to it
RUN npm install -g @anthropic-ai/claude-code

# Union of all agents/*/requirements.txt
RUN pip install --no-cache-dir \
    pyyaml==6.0.1 \
    "pydantic>=2.0.0" \
    requests==2.31.0 \
    "httpx>=0.27.0" \
    "openai>=1.30.0" \
    "fastapi>=0.110.0" \
    "uvicorn>=0.30.0" \
    watchfiles==0.21.0 \
    google-api-python-client==2.127.0 \
    google-auth-httplib2==0.2.0 \
    google-auth-oauthlib==1.2.0

WORKDIR /app

COPY agents/ /app/agents/
COPY scripts/ /app/scripts/
COPY supervisord.railway.conf /etc/supervisord.conf

RUN chmod +x /app/scripts/railway-entrypoint.sh

# Data dirs — Railway volume mount shadows these; entrypoint re-creates on first boot
RUN mkdir -p \
    /data/.hermes/main /data/.hermes/research /data/.hermes/subconscious \
    /data/.hermes/coder /data/.hermes/qa /data/.hermes/alim \
    /data/handoffs/incoming /data/handoffs/outgoing \
    /data/handoffs/completed /data/handoffs/failed && \
    chown -R hermes:hermes /data

EXPOSE 3000

# Health check against Railway-injected $PORT (main agent's gateway)
    CMD curl -sf "http://localhost:${PORT:-3000}/health" || exit 1

ENTRYPOINT ["/app/scripts/railway-entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
